SubDir HAIKU_TOP src apps glteapot ;
# In-tree GL (resurrected Mesa 7.4.4 fork) instead of the ppc-unavailable
# mesa/glu build-feature packages.
UseHeaders [ FDirName $(HAIKU_TOP) headers os opengl ] : true ;

local sources =
	FPS.cpp
	GLObject.cpp
	ObjectView.cpp
	error.cpp
	TeapotWindow.cpp
	TeapotApp.cpp
;

Application GLTeapot :
	$(sources)
	:
	be game localestub libGL.so [ TargetLibsupc++ ]
	: GLTeapot.rdef
;

DoCatalogs GLTeapot :
	x-vnd.Haiku-GLTeapot
	:
	TeapotApp.cpp
	TeapotWindow.cpp
;
