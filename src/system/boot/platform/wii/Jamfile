SubDir HAIKU_TOP src system boot platform wii ;

UsePrivateHeaders [ FDirName graphics common ] ;
UsePrivateHeaders interface ;

{
	local defines = _BOOT_PLATFORM_WII GEKKO HW_RVL ;
	defines = [ FDefines $(defines) ] ;
	SubDirCcFlags $(defines) -idirafter /opt/devkitpro/libogc/include ;
	SubDirC++Flags $(defines) -fno-rtti -idirafter /opt/devkitpro/libogc/include ;
}

# Ensure the linker finds libogc and input libraries when producing the final ELF
LINKFLAGS on boot_loader_wii += -L/opt/devkitpro/libogc/lib/wii ;
# The libgcc path is left unglobbed so the link command's shell resolves
# whichever devkitPPC compiler version the image happens to ship.
LINKLIBS on boot_loader_wii += /opt/devkitpro/libogc/lib/wii/libwiikeyboard.a /opt/devkitpro/libogc/lib/wii/libwiiuse.a /opt/devkitpro/libogc/lib/wii/libbte.a /opt/devkitpro/libogc/lib/wii/libfat.a /opt/devkitpro/libogc/lib/wii/libogc.a /opt/devkitpro/devkitPPC/lib/gcc/powerpc-eabi/*/libgcc.a ;

local platform_src =
	entry.S
	start.cpp
	arch_start_kernel.S
	wii_sd_boot_device.cpp
	mmu.cpp
	console.cpp
	debug.cpp
;

local kernel_src =
;

# the page table hash the loader and the kernel have to agree on
local kernel_arch_src =
	arch_mmu.cpp
	arch_cpu_asm.S
;

local platform ;
for platform in [ MultiBootSubDirSetup wii ] {
	on $(platform) {
		BootMergeObject boot_platform_wii.o :

			$(platform_src)
			$(kernel_src)
			$(kernel_arch_src)
		:
		:
			boot_platform_generic_wii.a
		;

		SEARCH on [ FGristFiles $(kernel_src) ]
			= [ FDirName $(HAIKU_TOP) src system kernel platform wii ] ;

		SEARCH on [ FGristFiles $(kernel_arch_src) ]
			= [ FDirName $(HAIKU_TOP) src system kernel arch
				$(TARGET_KERNEL_ARCH_DIR) ] ;
	}
}
