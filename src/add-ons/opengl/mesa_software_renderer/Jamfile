SubDir HAIKU_TOP src add-ons opengl mesa_software_renderer ;

SetSubDirSupportedPlatformsBeOSCompatible ;

UseHeaders [ FDirName $(HAIKU_TOP) headers os opengl ] : true ;


{
	local defines ;
	defines = BEOS_THREADS GNU_ASSEMBLER ;

	if $(TARGET_ARCH) = x86 {
		defines += USE_X86_ASM USE_MMX_ASM USE_3DNOW_ASM USE_SSE_ASM ;
	} else if $(TARGET_ARCH) = ppc {
		# Not yet supported, as current Mesa3D PPC assembly is Linux-dependent!
		# defines += USE_PPC_ASM ;
	} else if $(TARGET_ARCH) = sparc {
		defines += USE_SPARC_ASM ;
	}

	SubDirC++Flags [ FDefines $(defines) ] ;
}


local sources = MesaSoftwareRenderer.cpp ;

UsePrivateHeaders interface ;
# In-tree Mesa 7.4.4 fork (resurrected for the ppc port)
local mesaDir = [ FDirName $(HAIKU_TOP) src libs mesa mesa ] ;
UseLibraryHeaders mesa ;
UseHeaders $(mesaDir) ;
UseHeaders [ FDirName $(mesaDir) main ] ;
UseHeaders [ FDirName $(mesaDir) glapi ] ;
UseHeaders [ FDirName $(mesaDir) swrast ] ;
UseHeaders [ FDirName $(mesaDir) swrast_setup ] ;
UseHeaders [ FDirName $(mesaDir) tnl ] ;
UseHeaders [ FDirName $(mesaDir) vbo ] ;
UseHeaders [ FDirName $(mesaDir) shader ] ;

Addon Mesa\ Software\ Renderer :
	MesaSoftwareRenderer.cpp
	: libGL.so libmesa.a be
	[ TargetLibstdc++ ] [ TargetLibsupc++ ]
;
