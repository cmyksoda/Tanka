SubDir HAIKU_TOP src add-ons kernel busses usb ;

SubDirC++Flags -fno-rtti ;

UsePrivateKernelHeaders ;
UseHeaders [ FDirName $(HAIKU_TOP) src add-ons kernel bus_managers usb ] ;

KernelAddon <usb>uhci :
	uhci.cpp
	uhci_rh.cpp
	: libusb.a
	: uhci.rdef
	;

local ohci_sources =
	ohci.cpp
	ohci_rh.cpp
;

if $(TARGET_ARCH) = powerpc {
	ohci_sources += ohci_wii.cpp ;
}

KernelAddon <usb>ohci :
	$(ohci_sources)
	: libusb.a
	: ohci.rdef
	;

KernelAddon <usb>ehci :
	ehci.cpp
	ehci_rh.cpp
	: libusb.a
	: ehci.rdef
	;

KernelAddon <usb>xhci :
	xhci.cpp
	xhci_rh.cpp
	: libusb.a
	: xhci.rdef
	;

